<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- build\ 配下に .cs 等が混ざらないよう既定のコンパイル対象から除外 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);build\**\*</DefaultItemExcludes>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>resources\app.manifest</ApplicationManifest>
    <AssemblyName>AIUsage</AssemblyName>
    <RootNamespace>AIUsage.Windows</RootNamespace>
    <!-- 実行中の AIUsage が build\Release\net* を掴んでいてもビルドできるよう、TFM なしの別フォルダへ出力 -->
    <BaseOutputPath>build\</BaseOutputPath>
    <OutputPath>$(MSBuildProjectDirectory)\build\out-win\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <SatelliteResourceLanguages>en-US;ja-JP;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="System.Speech" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AIUsage.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Package.appxmanifest" CopyToOutputDirectory="Never" />
    <None Include="Assets\**\*" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <Target Name="ReadWindowsVersion" BeforeTargets="GetAssemblyVersion">
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\version.txt">
      <Output TaskParameter="Lines" PropertyName="Version" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <AssemblyVersion>$(Version).0</AssemblyVersion>
      <FileVersion>$(Version).0</FileVersion>
    </PropertyGroup>
  </Target>
</Project>
